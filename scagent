#!/usr/bin/env bash
# scagent: single-cell analysis agent in the opencode TUI. `scagent help` lists commands.
#
# This wrapper only finds scagent-sdk and its agent Python, then runs launcher/scagent.py.
# scagent-sdk is found from $SCAGENT_SDK_ROOT, or as a sibling folder of this one (a
# development checkout or an installed release, which use the same layout).
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
LAUNCHER_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
while [ -L "$SOURCE" ]; do
  source_dir="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$source_dir/$SOURCE"
done
HERE="$(cd -P "$(dirname "$SOURCE")" && pwd)"

SDK="${SCAGENT_SDK_ROOT:-$(cd -P "$HERE/../scagent-sdk" 2>/dev/null && pwd || true)}"
if [ -z "$SDK" ] || [ ! -d "$SDK" ]; then
  echo "scagent: scagent-sdk not found next to $HERE; set SCAGENT_SDK_ROOT" >&2
  exit 2
fi
PY="${SCAGENT_PYTHON:-$SDK/.venv/bin/python}"
if [ ! -x "$PY" ]; then
  echo "scagent: the agent Python is missing ($PY)." >&2
  echo "  In a development checkout: (cd $SDK && source setup_gpu.sh)" >&2
  exit 2
fi

export SCAGENT_HOME="$HERE" SCAGENT_SDK_ROOT="$SDK" SCAGENT_LAUNCHER_DIR="$LAUNCHER_DIR"
exec "$PY" -I "$HERE/launcher/scagent.py" "$@"
